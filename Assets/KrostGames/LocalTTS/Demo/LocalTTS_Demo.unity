  _voiceProfile: {fileID: 11400000, guid: 00a6832f4eebee64194b6b60ddf1a537, type: 2}
  _voice:
    voiceName: 
    language: 0
    rate: 0
    pitch: 0
    volume: 100
  _lines:
  - text: "\xA1Hola! Soy un TTS Speaker y mis l\xEDneas ya est\xE1n horneadas en
      clips de audio."
    clip: {fileID: 8300000, guid: d39de7c2da3b86542862628aadb1d4fd, type: 3}
    _bakedSignature: 6f929bca53e65853
  - text: "En Windows tambi\xE9n puedo decir cualquier cosa en tiempo real, sin hornear
      nada."
    clip: {fileID: 8300000, guid: f62e3f35c067dee4fa69c35ab5351dc9, type: 3}
    _bakedSignature: 6e46a4a014bb5a05
  - text: Todo funciona sin internet y sin gastar tokens.
    clip: {fileID: 8300000, guid: 57f70647d5e214e4a8b7c745b403a598, type: 3}
    _bakedSignature: 441f931dcd398c57
