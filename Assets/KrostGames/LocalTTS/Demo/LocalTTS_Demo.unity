  _voice:
    voiceName: 
    language: 0
    rate: 0
    pitch: 0
    volume: 100
  _lines:
  - text: Hi! I'm a TTS Speaker, and my lines are already baked into audio clips.
    clip: {fileID: 8300000, guid: 6a417fee82dacf84a9c2d7c4ca43c811, type: 3}
    _bakedSignature: b014cffe71a56832
  - text: 'Baked lines play everywhere: Android, iOS, WebGL and consoles.'
    clip: {fileID: 8300000, guid: 848c6c4e45c81f6408dab9b1e662999d, type: 3}
    _bakedSignature: c476108c720685d0
  - text: In the Windows editor I can also say anything in real time. No bake needed.
    clip: {fileID: 8300000, guid: 90a65d01ace6b7c4b821c51c911ed92b, type: 3}
    _bakedSignature: a5f1393252d90cf8
