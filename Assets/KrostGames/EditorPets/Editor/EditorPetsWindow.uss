.root {
    flex-grow: 1;
    background-color: #2b2b2b;
    flex-direction: column;
}

.title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #e0e0e0;
    margin: 5px 0 10px 0;
    align-self: center;
    flex-shrink: 0;
}

.lang-container {
    flex-direction: row;
    justify-content: flex-end;
    padding: 5px;
    flex-shrink: 0;
}

.lang-btn {
    font-size: 10px;
    background-color: #333;
    color: #888;
    border-radius: 3px;
    margin-left: 5px;
    padding: 2px 6px;
    border-width: 1px;
    border-color: #444;
}

.lang-btn.active {
    background-color: #059669;
    color: white;
    border-color: #10b981;
}

.toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 8px;
    background-color: #323232;
    border-radius: 6px;
    margin: 0 10px 10px 10px;
    border-width: 1px;
    border-color: #1a1a1a;
    flex-shrink: 0;
}

.toolbar-btn {
    margin: 2px;
    padding: 6px 12px;
    border-radius: 4px;
    background-color: #4a4a4a;
    color: #e0e0e0;
    border-width: 1px;
    border-color: #2a2a2a;
    -unity-font-style: bold;
}

.toolbar-btn:hover {
    background-color: #5a5a5a;
}

.toolbar-btn.active {
    background-color: #059669;
    color: white;
    border-color: #10b981;
}

.main-scroll {
    flex-grow: 1;
}

.content-container {
    padding: 10px;
    flex-grow: 1;
}

.section {
    background-color: #383838;
    border-radius: 6px;
    padding: 10px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: #1a1a1a;
    flex-shrink: 0;
}

.section-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #ff8246;
    margin-bottom: 8px;
}

.help-box {
    background-color: #2e2e2e;
    border-radius: 4px;
    padding: 10px;
    border-width: 1px;
    border-color: #1a1a1a;
}

.row {
    flex-direction: row;
    align-items: center;
}

.compact-toggle {
    width: 110px;
    margin-right: 10px;
    flex-shrink: 0;
}

.flex-grow-slider {
    flex-grow: 1;
    min-width: 80px;
}

.global-foldout {
    margin-top: 8px;
}

.global-items-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.global-items-fields {
    flex-grow: 1;
    min-width: 200px;
}

.global-items-fields > * {
    margin-bottom: 4px;
}

.ball-preview {
    width: 64px;
    height: 64px;
    align-self: center;
    margin-left: 10px;
    background-color: #2a2a2a;
    border-radius: 4px;
    flex-shrink: 0;
}

.pets-section {
    flex-grow: 1;
}

.pets-list {
    flex-direction: column;
}

.footer-container {
    padding: 8px;
    background-color: #222222;
    border-top-width: 1px;
    border-top-color: #111111;
    flex-shrink: 0;
}

.footer {
    align-self: center;
    color: #666666;
    font-size: 11px;
    -unity-font-style: italic;
}

.help-btn {
    position: absolute;
    bottom: 5px;
    right: 5px;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: #4a4a4a;
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: #2a2a2a;
    -unity-text-align: middle-center;
    padding: 0;
}

.help-btn:hover {
    background-color: #5a5a5a;
}
